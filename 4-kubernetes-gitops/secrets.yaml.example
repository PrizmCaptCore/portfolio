# Example secrets file - DO NOT COMMIT ACTUAL SECRETS
# Copy this file to secrets.yaml and fill in actual values

apiVersion: v1
kind: Secret
metadata:
  name: postgres-secrets
  namespace: mlops
type: Opaque
stringData:
  password: "CHANGE_ME_postgres_password"
  mlflow-password: "CHANGE_ME_mlflow_password"
  airflow-password: "CHANGE_ME_airflow_password"
  clearml-password: "CHANGE_ME_clearml_password"
---
apiVersion: v1
kind: Secret
metadata:
  name: mlflow-secrets
  namespace: mlops
type: Opaque
stringData:
  aws-access-key-id: "CHANGE_ME_AWS_ACCESS_KEY"
  aws-secret-access-key: "CHANGE_ME_AWS_SECRET_KEY"
---
apiVersion: v1
kind: Secret
metadata:
  name: airflow-secrets
  namespace: mlops
type: Opaque
stringData:
  sql-alchemy-conn: "postgresql+psycopg2://airflow:CHANGE_ME@postgres-service:5432/airflow"
  result-backend: "db+postgresql://airflow:CHANGE_ME@postgres-service:5432/airflow"
  fernet-key: "CHANGE_ME_32_byte_fernet_key"
  webserver-secret-key: "CHANGE_ME_webserver_secret"
---
apiVersion: v1
kind: Secret
metadata:
  name: clearml-secrets
  namespace: mlops
type: Opaque
stringData:
  api-key: "CHANGE_ME_clearml_api_key"
  api-secret: "CHANGE_ME_clearml_api_secret"

# To generate Fernet key for Airflow:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# To generate webserver secret key:
# openssl rand -hex 32
