# Local developer overrides — copy to .env and fill in values.
# This file is safe to commit. .env is gitignored.

# Path to the official ORT dylib (required when using the load-dynamic feature).
# Download ORT 1.22.0 for your platform from:
#   https://github.com/microsoft/onnxruntime/releases/tag/v1.22.0
# Then place the dylib at e.g. <repo-root>/ort-lib/libonnxruntime.dylib
#
# ORT_DYLIB_PATH=/absolute/path/to/ort-lib/libonnxruntime.dylib

# AWS named profile (incl. SSO profile) used by scripts/release-windows.ps1
# to fetch the Tauri minisign privkey from Secrets Manager. Loaded
# automatically when running `make release-windows`. Empty value is ignored
# (the script falls back to $env:AWS_PROFILE or the AWS CLI default).
#
# AWS_PROFILE=<profile>
AWS_PROFILE=