# 로컬에서 terraform 을 돌릴 때 필요한 환경변수. env/.env 로 복사해 채운 뒤
#   set -a; source env/.env; set +a
# NHN Cloud provider (OpenStack 호환 변수)
OS_USERNAME=
OS_PASSWORD=
OS_TENANT_ID=
OS_AUTH_URL=https://api-identity-infrastructure.nhncloudservice.com/v2.0
OS_REGION_NAME=KR1
# 원격 tfstate (Object Storage S3 API 자격 증명)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# terraform 변수
TF_VAR_deploy_repo=your-org/some-product
TF_VAR_deploy_ref=main
TF_VAR_deploy_token=
