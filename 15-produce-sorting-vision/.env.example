# 사이트별 경로. 쉘에서 export 하거나 `set -a; source .env; set +a`.

# ai_part/src/extract_from_nas.py
NAS_ROOT=\\nas\share\videos             # 촬영 영상이 올라가는 NAS 공유 (UNC)
NAS_FOLDER=potato_videos                # NAS_ROOT 아래 기본 회차 폴더
WSL_UNC_PREFIX=\\wsl.localhost\Ubuntu   # Windows 에서 본 이 WSL 배포판

# ai_part/src/tools/*
DATA_TEST_DIR=                          # 비우면 <repo>/data_test

# sketch_test/*
CAMERA_IP=192.168.0.2                   # 단일 카메라 진단 스크립트 기본 대상
CAMERA_IPS=192.168.0.1,192.168.0.2      # gvcp_unicast.py 도달성 점검 대상
