# cp .env.example .env  — all values are lab defaults; change every password before exposing a port.

# Orthanc (both instances share the REST user; separate databases)
ORTHANC_USER=orthanc
ORTHANC_PASSWORD=change-me-orthanc
ORTHANC_DB_PASSWORD=change-me-orthanc-db

# EHRbase
EHRBASE_USER=ehrbase-user
EHRBASE_PASSWORD=change-me-ehrbase
EHRBASE_ADMIN_USER=ehrbase-admin
EHRBASE_ADMIN_PASSWORD=change-me-ehrbase-admin
EHRBASE_DB_PASSWORD=change-me-ehrbase-db
EHRBASE_DB_ADMIN_PASSWORD=change-me-ehrbase-db-admin

# De-identification
# HMAC key (>= 32 random bytes, hex). Keep it out of the compose file and out of git.
#   python -c "import secrets; print(secrets.token_hex(32))"
DEID_SECRET=
# openEHR subject namespace the pseudonyms are issued under (EHR_STATUS.subject.external_ref.namespace)
DEID_NAMESPACE=imaging-research
